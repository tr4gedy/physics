<Window x:Class="prct.Views.AddTopicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prct.Views"
        mc:Ignorable="d"
        Title="AddTopicWindow" Height="250" Width="250">
    <Grid>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,5">
            <Label Content="Название"  Height="25"/>
            <TextBox Height="20" Width="100" x:Name="nameText" VerticalContentAlignment="Center"/>
            <Label Content="Описание"  Height="25"/>
            <TextBox Height="20" Width="100"  x:Name="descriptionText" VerticalContentAlignment="Center"/>
            <Button Content="Add" Width="100" Height="20" Click="AddBtn_Click" />
        </StackPanel>
    </Grid>
</Window>
