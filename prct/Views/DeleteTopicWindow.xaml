<Window x:Class="prct.Views.DeleteTopicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prct.Views"
        mc:Ignorable="d"
        Title="DeleteTopicWindow" Height="250" Width="250">
    <Grid>
        <StackPanel VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,5,0,5">
            <Label Content="Введите id темы для удаления:"  Height="25"/>
            <TextBox Height="20" Width="100" x:Name="idText" VerticalContentAlignment="Center"/>
        
            <Button Content="Delete" Width="100" Height="20" Click="DeleteBtn_Click" />
        </StackPanel>
    </Grid>
</Window>
