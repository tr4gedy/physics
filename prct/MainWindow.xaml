<Window x:Class="prct.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Физика" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="175*"/>
            <RowDefinition Height="32*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="589*"/>
            <ColumnDefinition Width="191*"/>

        </Grid.ColumnDefinitions>
        <DataGrid x:Name="TopicsDataGrid"
                  ItemsSource="{Binding Topics}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Grid.ColumnSpan="2" RenderTransformOrigin="0.54,0.486">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="300"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel HorizontalAlignment="Left" Width="100" VerticalAlignment="Center" Height="50" Grid.Row="1">
            <Button x:Name="AddTopicAsync"
                    Content="Добавить"
                    Height="20" 
                    Width="100"
                    Margin="0,5,0,5" 
                    Click="AddTopic_Click"/>
            <Button x:Name="DeleteTopicAsync"
                    Content="Удалить" 
                    Height="20" 
                    Width="100" 
                    Click="DeleteTopic_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="1" 
                    Grid.Column="1"
                    Margin="0,5,0,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content ="Ампер"
                    Height="20"
                    Width="100"
                    Margin="0,5,0,5"
                    Click="Amper_Click"/>
            <Button Content ="Ом"
                    Height="20"
                    Width="100"
                    Click="Om_Click"/>
        </StackPanel>
    </Grid>
</Window>
